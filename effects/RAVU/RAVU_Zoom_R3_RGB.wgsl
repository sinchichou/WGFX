	res += sample20 * w[3];
	w = textureSampleLevel(ravu_zoom_lut3, sam_ravu_zoom_lut3, vec2<f32>(0.8, coord_y) + subpix_inv, 0.0);
	res += sample19 * w[0];
	res += sample18 * w[1];
	res = clamp(res, vec3<f32>(0.0), vec3<f32>(1.0));
	imageStoreOverride(vec2<i32>(gl_GlobalInvocationID), vec4<f32>(res, 1.0));
}
//! END

		dot(samples[0], vec4<f32>(bitcast<f32>(-1135206239i), bitcast<f32>(-1139065871i), bitcast<f32>(1026230428i), bitcast<f32>(1025917606i))) + dot(samples[1], vec4<f32>(bitcast<f32>(1027050280i), bitcast<f32>(1013849783i), bitcast<f32>(1016077019i), bitcast<f32>(-1127829351i)))
		+ dot(samples[2], vec4<f32>(bitcast<f32>(-1140752647i), bitcast<f32>(-1123380440i), bitcast<f32>(988696695i), bitcast<f32>(-1092786651i))) + dot(samples[3], vec4<f32>(bitcast<f32>(1049996339i), bitcast<f32>(1057784826i), bitcast<f32>(1033822297i), bitcast<f32>(1034470972i)))
		+ dot(samples[4], vec4<f32>(bitcast<f32>(1022777359i), bitcast<f32>(1021581075i), bitcast<f32>(-1122295168i), bitcast<f32>(-1085937537i)))
		+ dot(samples[5], vec4<f32>(bitcast<f32>(1032573953i), bitcast<f32>(-1130048007i), bitcast<f32>(1032545188i), bitcast<f32>(-1137094527i))) + dot(samples[6], vec4<f32>(bitcast<f32>(974924014i), bitcast<f32>(-1133276463i), bitcast<f32>(1029689087i), bitcast<f32>(-1140169471i)))
		+ dot(samples[7], vec4<f32>(bitcast<f32>(-1135329695i), bitcast<f32>(-1124883951i), bitcast<f32>(1011238415i), bitcast<f32>(1001568686i)));
	sum1 = exp(sum1 * mstd2 + bitcast<f32>(1058918200i));
sum2 = sum2 * mstd2 + bitcast<f32>(-1121082995i);
wsum += sum1;
vsum += sum1 * (sum2 / (1.0 + abs(sum2)));

	return clamp(mstd0 + 5.0 * vsum / wsum * mstd1, 0.0, 1.0);
}

var<workgroup> inp: array<f32, 525>;


fn imageStoreOverride(pos: vec2<i32>, value: f32) {
	var UV: vec2<f32> = ((rgb2uv) * (textureSampleLevel(INPUT, sam_INPUT_LINEAR, HOOKED_map(vec2<f32>(pos)), 0).rgb));
	textureStore(OUTPUT, vec2<i32>(pos), vec4<f32>(((yuv2rgb) * (vec3<f32>(value.x, UV))), 1.0));
}

const INPUT_size: vec2<f32> = vec2<f32>(scene.inputSize);
const INPUT_pt: vec2<f32> = vec2<f32>(scene.inputPt);

const temp_size: vec2<f32> = vec2<f32>(scene.inputSize.x * 1, scene.inputSize.y * 2);
const temp_pt: vec2<f32> = vec2<f32>(1.0 / (temp_size.x), 1.0 / (temp_size.y));


fn Pass2(@builtin(workgroup_id) wgid: vec3<u32>, @builtin(local_invocation_id) lid: vec3<u32>) {
    let blockStart: vec2<u32> = wgid.xy * vec2<u32>(64u, 8u);
    let threadId: vec3<u32> = lid;
    let gl_WorkGroupID: vec2<u32> = wgid.xy;
    let gl_WorkGroupSize: vec2<u32> = vec2<u32>(32u, 8u);
    let gl_LocalInvocationID: vec3<u32> = lid;
    let gl_LocalInvocationIndex: u32 = lid.y * 32u + lid.x;
    let gl_GlobalInvocationID: vec2<u32> = wgid.xy * gl_WorkGroupSize + lid.xy;

	var group_base: vec2<u32> = gl_WorkGroupID * gl_WorkGroupSize;
	var local_pos: i32 = i32(gl_LocalInvocationID.x) * 15 + i32(gl_LocalInvocationID.y);
	for (var id: i32 = i32(gl_LocalInvocationIndex); id < 525; id += i32(gl_WorkGroupSize.x * gl_WorkGroupSize.y)) {
		var x: u32 = u32(id) / 15; var y: u32 = u32(id) % 15;
		inp[id] =
			temp_tex(temp_pt * vec2<f32>(f32(group_base.x + x - (1)) + 0.5, f32(group_base.y + y - (3)) + 0.5));
	}
	workgroupBarrier();
	var ret: vec4<f32> = vec4<f32>(0.0, 0.0, 0.0, 0.0);
	var ret0: vec4<f32> = vec4<f32>(0.0, 0.0, 0.0, 0.0);
	var samples: array<vec4<f32>, 8>;
	samples[0][0] = inp[local_pos + 0];
	samples[0][1] = inp[local_pos + 1];
	samples[0][2] = inp[local_pos + 2];
	samples[0][3] = inp[local_pos + 3];
	samples[1][0] = inp[local_pos + 4];
	samples[1][1] = inp[local_pos + 5];
	samples[1][2] = inp[local_pos + 6];
	samples[1][3] = inp[local_pos + 7];
	samples[2][0] = inp[local_pos + 15];
	samples[2][1] = inp[local_pos + 16];
	samples[2][2] = inp[local_pos + 17];
	samples[2][3] = inp[local_pos + 18];
	samples[3][0] = inp[local_pos + 19];
	samples[3][1] = inp[local_pos + 20];
	samples[3][2] = inp[local_pos + 21];
	samples[3][3] = inp[local_pos + 22];
	samples[4][0] = inp[local_pos + 30];
	samples[4][1] = inp[local_pos + 31];
	samples[4][2] = inp[local_pos + 32];
	samples[4][3] = inp[local_pos + 33];
	samples[5][0] = inp[local_pos + 34];
	samples[5][1] = inp[local_pos + 35];
	samples[5][2] = inp[local_pos + 36];
	samples[5][3] = inp[local_pos + 37];
	samples[6][0] = inp[local_pos + 45];
	samples[6][1] = inp[local_pos + 46];
	samples[6][2] = inp[local_pos + 47];
	samples[6][3] = inp[local_pos + 48];
	samples[7][0] = inp[local_pos + 49];
	samples[7][1] = inp[local_pos + 50];
	samples[7][2] = inp[local_pos + 51];
	samples[7][3] = inp[local_pos + 52];
	ret[0] = nnedi3(samples);
	ret0[0] = inp[local_pos + 18];
	var destPos: vec2<u32> = blockStart + threadId.xy * vec2<u32>(2u, 1u);
	var outputSize: vec2<u32> = scene.outputSize;
	if (destPos.x >= outputSize.x || destPos.y >= outputSize.y) {
		return;
	}
	imageStoreOverride(vec2<i32>(gl_GlobalInvocationID) * vec2<i32>(2, 1), ret0.x);
	imageStoreOverride(vec2<i32>(gl_GlobalInvocationID) * vec2<i32>(2, 1) + vec2<i32>(1, 0), ret.x);
}

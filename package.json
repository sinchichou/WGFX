{
  "name": "wgfx",
  "version": "1.0.0",
  "description": "WebGPU Effect Framework — parse and run Magpie-style .wgsl effect files",
  "main": "dist/wgfx.js",
  "module": "dist/wgfx.browser.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/wgfx.browser.esm.js",
      "import": "./dist/wgfx.esm.js",
      "require": "./dist/wgfx.js"
    },
    "./browser": {
      "types": "./dist/index.d.ts",
      "default": "./dist/wgfx.browser.esm.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "README_TW.md",
    "LICENSE"
  ],
  "scripts": {
    "generate:parser": "peggy --format es -o src/runtime/ShaderParser.js src/runtime/ShaderParser.pegjs",
    "prebuild": "npm run generate:parser",
    "build": "rollup -c",
    "prepare": "npm run build",
    "pack:check": "npm pack --dry-run",
    "pretest": "npm run build",
    "test": "node test/test_runtime.js",
    "test:opennr": "node test/opennr_network.mjs",
    "test:opennr:all": "node tools/opennr_weights.test.mjs && node test/opennr_ref_smoke.mjs && node test/opennr_conv_equiv.mjs && node test/opennr_spike.mjs && node test/opennr_network.mjs",
    "test:port": "node test/port_check.mjs",
    "test:dispatch": "node test/dispatch_expr.test.mjs",
    "test:csp": "node test/csp_mv3_sim.test.mjs && node test/csp_mv3_opennr.test.mjs",
    "test:wgxp": "node test/wgxp.test.mjs",
    "test:wgxp:runtime": "node test/wgxp_runtime.test.mjs",
    "test:dds": "node test/dds_consistency.test.mjs",
    "test:split": "node test/split_passes.test.mjs",
    "pack": "node tools/pack/wgxp.mjs --batch effects --out-dir dist/wgx",
    "test:scalers": "node test/scalers_ref.mjs",
    "test:f16": "node test/f16_conversion.mjs",
    "test:ref": "node test/ref_probe_upscale_denoise_s.mjs",
    "bench": "node test/bench_runtime.mjs",
    "debug": "npm run dev --prefix debugger",
    "build:docs": "typedoc",
    "typecheck": "tsc --noEmit",
    "test:external": "node test/test_external_textures.mjs",
    "verify": "node tools/verify_shaders.mjs",
    "verify:batch": "node tools/verify_batch.mjs",
    "verify:scalers": "node tools/verify_batch.mjs --category Scalers",
    "verify:all": "node tools/verify_batch.mjs --all",
    "test:verification": "node test/verification_test.mjs"
  },
  "private": true,
  "dependencies": {
    "archiver": "^7.0.1",
    "commander": "^12.1.0",
    "glob": "^11.0.0",
    "onnxruntime-node": "^1.31.1",
    "pngjs": "^7.0.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.1",
    "webgpu": "^0.3.8"
  },
  "type": "module",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@types/node": "^25.0.3",
    "@types/pngjs": "^6.0.5",
    "@webgpu/types": "^0.1.68",
    "fast-glob": "^3.3.2",
    "peggy": "^5.0.6",
    "rollup": "^4.53.3",
    "rollup-plugin-polyfill-node": "^0.13.0",
    "rollup-plugin-typescript2": "^0.36.0",
    "tslib": "^2.8.1",
    "typedoc": "^0.28.15",
    "typedoc-plugin-markdown": "^4.9.0",
    "typescript": "^5.9.3"
  }
}
